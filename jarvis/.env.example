# ── Hangi beyin? (claude veya gemini) ─────────────────────────────────────
JARVIS_PROVIDER=gemini

# ── Gemini (varsayılan) ────────────────────────────────────────────────────
# https://aistudio.google.com/apikey adresinden oluştur
GEMINI_API_KEY=AIzaSy...buraya_yeni_anahtari_yapistir

# ── Claude (alternatif) ────────────────────────────────────────────────────
# JARVIS_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model seçimi ──────────────────────────────────────────────────────────
# Gemini:  gemini-2.0-flash  /  gemini-1.5-pro
# Claude:  claude-sonnet-4-6
JARVIS_MODEL=gemini-2.0-flash

# ── Ses ve STT ────────────────────────────────────────────────────────────
# edge-tts sesleri: tr-TR-AhmetNeural (erkek) / tr-TR-EmelNeural (kadın)
JARVIS_VOICE=tr-TR-AhmetNeural
# Whisper model: tiny / base / small / medium  (small önerilir)
JARVIS_STT_MODEL=small

# ── Minecraft köprüsü ─────────────────────────────────────────────────────
JARVIS_MC_BRIDGE=ws://localhost:8765
