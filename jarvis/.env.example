# ── Hangi beyin? (groq / gemini / claude) ─────────────────────────────────
JARVIS_PROVIDER=groq

# ── Groq (varsayılan — ücretsiz, çok hızlı, cömert kota) ───────────────────
# https://console.groq.com/keys adresinden ücretsiz oluştur
GROQ_API_KEY=gsk_...buraya_anahtari_yapistir

# ── Gemini (alternatif) ────────────────────────────────────────────────────
# JARVIS_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...

# ── Claude (alternatif) ────────────────────────────────────────────────────
# JARVIS_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model seçimi (boş bırakırsan otomatik en iyi model) ───────────────────
# Groq:    llama-3.3-70b-versatile  /  llama-3.1-8b-instant
# Gemini:  gemini-2.0-flash  /  gemini-1.5-flash
# Claude:  claude-sonnet-4-6
# JARVIS_MODEL=llama-3.3-70b-versatile

# ── Ses tanıma (STT) ──────────────────────────────────────────────────────
# Varsayılan: Groq bulut Whisper (whisper-large-v3-turbo) — çok hızlı, çok
# doğru, PC gücünden bağımsız. GROQ_API_KEY varsa otomatik kullanılır.
# İnternetsiz çalışmak istersen yerel modele dön:
# JARVIS_STT=local
# Yerel Whisper modeli: tiny / base / small / medium
JARVIS_STT_MODEL=base

# ── Ses sentezi (TTS) ─────────────────────────────────────────────────────
# gtts (varsayılan, Google sesi) / edge (Microsoft Ahmet sesi)
JARVIS_TTS=gtts
# edge seçersen ses: tr-TR-AhmetNeural (erkek) / tr-TR-EmelNeural (kadın)
JARVIS_VOICE=tr-TR-AhmetNeural
# Mikrofon seçimi (otomatik bulunur). Birden fazla mikrofon varsa veya
# "Mikrofon bulunamadı" hatası alıyorsan cihaz numarasını buraya yaz.
# Cihazları listelemek için: python -c "import sounddevice;print(sounddevice.query_devices())"
# JARVIS_MIC=1

# ── Minecraft köprüsü ─────────────────────────────────────────────────────
JARVIS_MC_BRIDGE=ws://localhost:8765
