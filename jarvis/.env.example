# Claude API anahtarını buraya yapıştır, dosyayı .env olarak kaydet
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (opsiyonel) kullanılacak model
JARVIS_MODEL=claude-sonnet-4-6

# (opsiyonel) Türkçe ses — edge-tts sesleri: tr-TR-AhmetNeural / tr-TR-EmelNeural
JARVIS_VOICE=tr-TR-AhmetNeural

# (opsiyonel) Whisper model boyutu: tiny / base / small / medium
JARVIS_STT_MODEL=small

# (opsiyonel) Minecraft botu köprü adresi
JARVIS_MC_BRIDGE=ws://localhost:8765
